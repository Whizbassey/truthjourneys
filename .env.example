# --- Sanity (required) -------------------------------------------------------
# Found at https://sanity.io/manage after you create a project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Write token (Editor role). Needed only for `npm run seed` and /api/subscribe.
SANITY_API_WRITE_TOKEN=

# --- Publishing webhook (optional) -------------------------------------------
# Shared secret so Sanity can tell this site to refresh a page instantly.
SANITY_REVALIDATE_SECRET=

# --- Newsletter (optional) ---------------------------------------------------
# If set, /api/subscribe forwards to Buttondown. Otherwise it stores the address
# in Sanity (needs SANITY_API_WRITE_TOKEN). If neither is set, the form reports
# that subscriptions are not configured yet.
BUTTONDOWN_API_KEY=

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
